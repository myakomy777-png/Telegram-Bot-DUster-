    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  return [{ json: { response: 'Товары не найдены в базе.' } }];\n}\n\nconst grouped = {};\nitems.forEach(item => {\n  const product = item.json.product_name;\n  if (!grouped[product]) grouped[product] = [];\n  grouped[product].push(item.json);\n});\n\nlet response = '';\n\nfor (const product in grouped) {\n  const sorted = grouped[product].sort((a, b) => a.price - b.price);\n  response += `Цены на ${product}:\\n\\n`;\n  sorted.forEach((item, index) => {\n    response += `${index + 1}. ${item.shop_name}\\n`;\n    response += `   Цена: ${item.price}тг\\n`;\n    if (item.address) response += `   Адрес: ${item.address}\\n`;\n    response += '\\n';\n  });\n  \n  // Найти минимальную цену\n  const minPrice = sorted[0].price;\n  const cheapest = sorted.filter(item => item.price == minPrice);\n  \n  if (cheapest.length === 1) {\n    response += `Самая низкая цена: ${cheapest[0].shop_name} — ${cheapest[0].price}тг\\n\\n`;\n  } else {\n    const shops = cheapest.map(item => item.shop_name).join(', ');\n    response += `Самая низкая цена: ${shops} — ${minPrice}тг\\n\\n`;\n  }\n  \n  response += '---\\n\\n';\n}\n\nreturn [{ json: { response } }];"
      },
