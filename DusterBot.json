    {
      "parameters": {
        "jsCode": "const text = $json.message.text;\nconst parts = text.split(' ');\n\nconst shop = parts[1] || '';\nconst product = parts[2] || '';\nconst price = parseFloat(parts[3]) || 0;\nconst address = parts.slice(4).join(' ') || '';\nconst chat_id = $json.message.chat.id;\n\n// Проверка на пустые поля\nif (!shop || !product || !price) {\n  return [{ json: { \n    error: true,\n    chat_id: chat_id,\n    error_message: '❌ Неправильный формат! Используйте:\\n/add [магазин] [товар] [цена] [адрес]\\n\\nПример:\\n/add Магнит картошка 150 ул.Ленина 5'\n  }}];\n}\n\nreturn [{ json: { shop, product, price, address, chat_id, error: false } }];"
