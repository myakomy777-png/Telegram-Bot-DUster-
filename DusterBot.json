    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst userMessage = $('Telegram Trigger').item.json.message.text.toLowerCase();\nconst chat_id = $('Telegram Trigger').item.json.message.chat.id;\n\n// Прямые ответы без ИИ\nconst aboutBot = ['что умеешь', 'что ты умеешь', 'что умеет', 'функции', 'команды', 'помощь', 'help', 'что можешь', 'что ты можешь'];\nconst aboutRequest = ['заявк', 'как подать', 'хочу подать'];\nconst aboutAdd = ['как добавить цен', 'помоги добавить', 'как использовать add', 'команду add'];\nconst aboutPrices = ['как посмотреть цен', 'как найти цен', 'команду prices'];\n\nif (aboutBot.some(w => userMessage.includes(w))) {\n  return [{ json: { direct_response: true, chat_id, response: 'Я умею:\\n1. Добавлять цены — /add Магнит картошка 150 ул.Ленина 5\\n2. Искать цены — /prices картошка\\n3. Принимать заявки — /заявка' }}];\n}\n\nif (aboutRequest.some(w => userMessage.includes(w))) {\n  return [{ json: { direct_response: true, chat_id, response: 'Напишите /заявка и выберите тип из меню: Доставка, Ремонт или Консультация.' }}];\n}\n\nif (aboutAdd.some(w => userMessage.includes(w))) {\n  return [{ json: { direct_response: true, chat_id, response: 'Чтобы добавить цену напишите:\\n/add [магазин] [товар] [цена] [адрес]\\n\\nПример: /add Магнит картошка 150 ул.Ленина 5' }}];\n}\n\nif (aboutPrices.some(w => userMessage.includes(w))) {\n  return [{ json: { direct_response: true, chat_id, response: 'Чтобы найти цены напишите:\\n/prices [товар]\\n\\nПример: /prices картошка' }}];\n}\n\nconst messages = items.map(item => ({\n  role: item.json.role,\n  content: item.json.message\n}));\n\nmessages.unshift({\n  role: \"system\",\n  content: `Ты помощник Telegram бота. Отвечай КОРОТКО — максимум 2 предложения. Всегда отвечай на русском языке.\n\nВАЖНО: Бот имеет только эти команды:\n- /add [магазин] [товар] [цена] [адрес] — добавить цену\n- /prices [товар] — найти цены\n- /заявка — подать заявку\n\nНикогда не придумывай другие команды. Если не знаешь ответ — скажи что не понял вопрос.`\n});\n\nreturn [{ json: { messages, direct_response: false } }];"
      },
